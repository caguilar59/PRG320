@model RestaurantApp.Models.Restaurant

@{
    ViewData["Title"] = "Delete Restaurant";
}

<div class="row justify-content-center">
    <div class="col-md-7">

        <div class="card shadow-lg border-0 rounded-4">

            <div class="card-header bg-danger text-white text-center py-3">
                <h2 class="mb-0">🗑 Delete Restaurant</h2>
            </div>

            <div class="card-body p-4">

                @if (Model != null)
                {
                    <div class="alert alert-warning text-center">
                        Are you sure you want to delete
                        <strong>@Model.Name</strong>?
                    </div>

                    <div class="mb-4 text-center">
                        <p class="mb-1"><strong>Location:</strong> @Model.Location</p>
                        <p class="mb-1"><strong>Cuisine:</strong> @Model.CuisineType</p>
                        <p class="mb-0"><strong>Rating:</strong> ⭐ @Model.Rating</p>
                    </div>

                    <form asp-action="Delete" method="post">

                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex justify-content-between">

                            <a asp-action="Index" class="btn btn-secondary px-4">
                                Cancel
                            </a>

                            <button type="submit" class="btn btn-danger px-4">
                                Delete
                            </button>

                        </div>

                    </form>
                }
                else
                {
                    <div class="alert alert-danger text-center">
                        Restaurant not found.
                    </div>

                    <div class="text-center">
                        <a asp-action="Index" class="btn btn-secondary px-4">
                            Back
                        </a>
                    </div>
                }

            </div>

        </div>

    </div>
</div>